# Copy to your shell environment; never commit real values.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=your_api_secret
TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_CREDENTIALS_FILE=/home/you/.config/agent-phone-number/twilio-credentials.json
# TWILIO_DRY_RUN=1                # read-only tools only
# TWILIO_ALLOW_ADMIN=1            # owner-authorized key/delete/admin actions only
# TWILIO_TIMEOUT_MS=60000
# TWILIO_ONBOARDING_COMPLETE=1        # CI/tests only; skips the owner checklist
# TWILIO_VERIFIED_RECIPIENT=1         # CI/tests only; marks the recipient verified
